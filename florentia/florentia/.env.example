# Este archivo sirve como plantilla para configurar tu archivo .env
# Copia este archivo a .env y modifica los valores según sea necesario
# El archivo .env debe ser excluido del control de versiones (ya está en .gitignore)

# API Key para OpenAI (REQUERIDO)
OPENAI_API_KEY=your_openai_api_key_here

# Variables opcionales
# APP_ENVIRONMENT=Development
# OPENAI_MODEL=gpt-3.5-turbo
# MAX_TOKENS=100
# TEMPERATURE=0.7